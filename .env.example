# Base de datos SQLite (el archivo se persiste en un volumen, ver docker-compose.yml)
DATABASE_URL="file:/app/data/prod.db"

# NextAuth - generar con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-por-un-valor-aleatorio-largo"
NEXTAUTH_URL="https://tu-dominio.ejemplo.com"

# Admin inicial: se crea automáticamente al levantar el contenedor si no existe
# un usuario con ese DNI. Cambiar la contraseña luego del primer ingreso.
ADMIN_DNI="00000000"
ADMIN_PASSWORD="cambiar-esta-clave"
ADMIN_NOMBRE="Administrador"
ADMIN_APELLIDO="Sistema"
